Level: {
	Experience: {
		Singleplayer:
			'''
			Level {0} | {3} unspent points
			{1} experience
			{2} to next level
			'''
		Multiplayer:
			'''
			Level {0} | {3} unspent points
			Average level: {4}
			{1} experience
			{2} to next level
			'''
	}

	Tooltip:
		'''
		+{0} life
		+{1} mana
		'''

	Popup: {
		Experience: +{0} XP
		LevelUp: Level Up!
	}
}

Brawn: {
	DisplayName: "[c/{0}:Brawn]"
	Tooltip:
		'''
		+{0} melee damage
		+{1} wing time
		+{2} pick speed
		'''
